rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.matches('(?i)^gierso@gmail\\.com$')
      );
    }

    // Users collection: All authenticated users can read and write profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Global settings collection (e.g. currentHourlyRate, currency, nannyName)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Shifts collection (daily work records)
    match /shifts/{shiftId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}

